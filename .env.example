# ---------------------------------------------------------------------------
# Japan Talent Desk — newsletter signup (existing public site)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_LIST_ID_JAPAN_MARKET_WEEKLY=
BREVO_SENDER_EMAIL=scout@ai-orchestra.work
BREVO_SENDER_NAME=Japan Talent Desk

# ---------------------------------------------------------------------------
# Japan Football Intelligence
# ---------------------------------------------------------------------------

# Mount point for the JFI product. The Japan Talent Desk landing page keeps "/".
# Set to "/" only when JFI is deployed on its own domain.
JFI_BASE_PATH=/intel
JFI_CANONICAL_ORIGIN=
JFI_TIMEZONE=Asia/Tokyo

# On Railway, point this at a persistent volume — the intelligence database is
# the asset, and a container rebuild must not lose it.
JFI_DB_PATH=./var/jfi.db

# The admin dashboard is 404 unless a password is set.
JFI_ADMIN_USER=admin
JFI_ADMIN_PASSWORD=

# Collection. Identify the crawler honestly; robots.txt is respected by default.
JFI_USER_AGENT=
JFI_RESPECT_ROBOTS=true
JFI_HTTP_HOST_DELAY_MS=1200
JFI_MAX_ARTICLES_PER_RUN=400
JFI_COLLECT_LOOKBACK_DAYS=7

# Rule-based relevance gate. Nothing below this score is ever sent to an LLM,
# so this is the primary cost control. Raising it cuts spend directly.
JFI_MIN_RELEVANCE=40

# LLM. Leave the key empty to run the whole pipeline on the deterministic mock
# provider — useful for local development and CI.
JFI_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
JFI_LLM_DAILY_CALL_BUDGET=600
JFI_LLM_DAILY_COST_BUDGET_USD=5

# Approval gates. docs/newsletter/operations.md forbids automated sending;
# leave these true unless that policy is deliberately changed.
JFI_NEWSLETTER_REQUIRE_APPROVAL=true
JFI_SOCIAL_REQUIRE_APPROVAL=true

# debug | info | warn | error
JFI_LOG_LEVEL=info
